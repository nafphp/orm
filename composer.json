{
  "name": "naf/orm",
  "description": "NAF ORM Plugin.",
  "minimum-stability": "stable",
  "license": "MIT",
  "type": "naf-plugin",
  "authors": [
    {
      "name": "Flo Knapp",
      "email": "office@florianknapp.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Naf\\ORM\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "naf/framework": "^0.2",
    "naf/database": "^0.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.25",
    "phpunit/php-code-coverage": "^12.1",
    "phpunit/phpunit": "^12.1"
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "style:fix": "@php vendor/bin/php-cs-fixer fix"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
